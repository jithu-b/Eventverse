# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-different-from-secret-key

# ---- Database ----
DATABASE_URL=sqlite:///instance/eventverse.db

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- File storage ----
UPLOAD_FOLDER=uploads

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- Email (for password reset) ----
MAIL_SENDER=noreply@eventverse.local
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=